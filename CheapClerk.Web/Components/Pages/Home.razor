@page "/"
@using CheapClerk.Configuration
@using Microsoft.Extensions.Options
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["AppDashboardTitle"]</PageTitle>

<PageHeader Kicker="CheapClerk" Title="@Loc["Dashboard"]" Subtitle="@Loc["HomeSubtitle"]" />

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default); cursor: pointer;"
                 @onclick="@(() => Navigation.NavigateTo("/documents"))">
            <MudCardContent Class="d-flex align-center gap-4">
                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h4">@_documentCount</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.6;">@Loc["Documents"]</MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default); cursor: pointer;"
                 @onclick="@(() => Navigation.NavigateTo("/tags"))">
            <MudCardContent Class="d-flex align-center gap-4">
                <MudIcon Icon="@Icons.Material.Filled.Label" Color="Color.Secondary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h4">@_tagCount</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.6;">@Loc["Tags"]</MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
            <MudCardContent Class="d-flex align-center gap-4">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Tertiary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h4">@_correspondentCount</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.6;">@Loc["Correspondents"]</MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="@($"border: 1px solid {(_expiringCount > 0 ? "rgba(255,87,34,0.5)" : "var(--mud-palette-lines-default)")}; cursor: pointer;")"
                 @onclick="@(() => Navigation.NavigateTo("/expiring"))">
            <MudCardContent Class="d-flex align-center gap-4">
                <MudIcon Icon="@Icons.Material.Filled.Schedule"
                         Color="@(_expiringCount > 0 ? Color.Warning : Color.Default)"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h4">@_expiringCount</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.6;">@Loc["ExpiringIn30Days"]</MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="@($"border: 1px solid {(_inboxCount > 0 ? "rgba(33,150,243,0.5)" : "var(--mud-palette-lines-default)")};")">
            <MudCardContent Class="d-flex align-center gap-4">
                <MudIcon Icon="@Icons.Material.Filled.MoveToInbox"
                         Color="@(_inboxCount > 0 ? Color.Info : Color.Default)" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h4">@_inboxCount</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.6;">@Loc["InInbox"]</MudText>
                </div>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           Disabled="@(_inboxCount == 0 || _processing)"
                           OnClick="@(() => ProcessInboxAsync())">
                    @(_processing ? Loc["Processing"] : Loc["ProcessNow"])
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="0" Style="@($"border: 1px solid {(_reviewCount > 0 ? "rgba(156,39,176,0.5)" : "var(--mud-palette-lines-default)")}; cursor: pointer;")"
                 @onclick="@(() => Navigation.NavigateTo("/review"))">
            <MudCardContent Class="d-flex align-center gap-4">
                <MudIcon Icon="@Icons.Material.Filled.RateReview"
                         Color="@(_reviewCount > 0 ? Color.Secondary : Color.Default)" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h4">@_reviewCount</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.6;">@Loc["NeedsReview"]</MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@if (_statistics is not null)
{
    @* Basic archive metrics — file mix, OCR volume, taxonomy size *@
    <MudPaper Class="pa-4 mt-6 d-flex align-center flex-wrap gap-2" Elevation="0"
              Style="border: 1px solid var(--mud-palette-lines-default);">
        @foreach (var fileType in _statistics.FileTypeCounts)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                @fileType.Count × @FileTypeLabel(fileType.MimeType)
            </MudChip>
        }
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            · @Loc["MetricsCharacters", (_statistics.CharacterCount / 1000.0).ToString("0.#")]
            · @Loc["MetricsTypes", _statistics.DocumentTypeCount]
        </MudText>
    </MudPaper>
}

<MudText Typo="Typo.h5" Class="mt-8 mb-4">@Loc["RecentlyAdded"]</MudText>

@if (_recentDocuments is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_recentDocuments.Count == 0)
{
    <MudAlert Severity="Severity.Info">@Loc["NoDocumentsFoundStartScanning"]</MudAlert>
}
else
{
    <MudTable Items="_recentDocuments" Hover="true" Elevation="0" Dense="true"
              Style="border: 1px solid var(--mud-palette-lines-default);">
        <HeaderContent>
            <MudTh>@Loc["Id"]</MudTh>
            <MudTh>@Loc["Title"]</MudTh>
            <MudTh>@Loc["Added"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Id</MudTd>
            <MudTd>
                <MudLink Href="@($"/documents/{context.Id}")">@context.Title</MudLink>
            </MudTd>
            <MudTd>@(context.Added?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Inject] private PaperlessClient PaperlessClient { get; set; } = null!;
    [Inject] private ExtractionCacheService ExtractionCache { get; set; } = null!;
    [Inject] private InboxProcessorService InboxProcessor { get; set; } = null!;
    [Inject] private IOptions<ClassificationOptions> ClassificationConfig { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private List<PaperlessDocument>? _recentDocuments;
    private PaperlessStatistics? _statistics;
    private int _documentCount;
    private int _tagCount;
    private int _correspondentCount;
    private int _expiringCount;
    private int _inboxCount;
    private int _reviewCount;
    private bool _processing;

    protected override async Task OnInitializedAsync()
    {
        var statisticsTask = PaperlessClient.GetStatisticsAsync();
        var docsTask = PaperlessClient.ListDocumentsAsync(maxResults: 10);
        var expiringTask = ExtractionCache.FindExpiringAsync(30);

        await Task.WhenAll(statisticsTask, docsTask, expiringTask);

        _recentDocuments = await docsTask;
        _statistics = await statisticsTask;
        var expiring = await expiringTask;

        // Archive-wide totals from the statistics endpoint — the recent-docs list
        // is paginated and must never masquerade as a total
        _documentCount = _statistics?.DocumentsTotal ?? _recentDocuments.Count;
        _tagCount = _statistics?.TagCount ?? 0;
        _correspondentCount = _statistics?.CorrespondentCount ?? 0;
        _expiringCount = expiring.Count;

        await LoadWorkflowCountsAsync();
    }

    private static string FileTypeLabel(string mimeType) => mimeType switch
    {
        "application/pdf" => "PDF",
        "image/jpeg" => "JPG",
        "image/png" => "PNG",
        "image/webp" => "WEBP",
        "image/gif" => "GIF",
        "image/tiff" => "TIFF",
        _ => mimeType.Contains('/') ? mimeType[(mimeType.IndexOf('/') + 1)..].ToUpperInvariant() : mimeType
    };

    private async Task ProcessInboxAsync()
    {
        if (_processing) return;
        _processing = true;
        try
        {
            var report = await InboxProcessor.ProcessInboxAsync();
            if (report.SkippedReason is not null)
            {
                Snackbar.Add(Loc["InboxProcessingSkipped", report.SkippedReason].Value, Severity.Warning);
            }
            else
            {
                var applied = report.Outcomes.Count(o => o.Applied);
                var review = report.Outcomes.Count(o => o.SentToReview);
                var failed = report.Outcomes.Count(o => o.Error is not null);
                var severity = failed > 0
                    ? Severity.Error
                    : review > 0 ? Severity.Warning : Severity.Success;
                Snackbar.Add(Loc["InboxProcessed", applied, review, failed].Value, severity);
            }
            await LoadWorkflowCountsAsync();
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task LoadWorkflowCountsAsync()
    {
        var tags = await PaperlessClient.GetTagsAsync();
        var inboxTag = tags.FirstOrDefault(t =>
            t.Name.Equals(ClassificationConfig.Value.InboxTagName, StringComparison.OrdinalIgnoreCase));
        var reviewTag = tags.FirstOrDefault(t =>
            t.Name.Equals(ClassificationConfig.Value.ReviewTagName, StringComparison.OrdinalIgnoreCase));
        _inboxCount = inboxTag?.DocumentCount ?? 0;
        _reviewCount = reviewTag?.DocumentCount ?? 0;
    }
}
