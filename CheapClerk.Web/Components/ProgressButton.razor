@* House rule: any async action self-disables, swaps its StartIcon for a
   spinner, guards re-entry and resets in finally — never a bare MudButton
   on an awaited call. *@
<MudButton Variant="@Variant" Color="@Color" Size="@Size" Class="@Class"
           StartIcon="@(_busy ? null : StartIcon)"
           FullWidth="@FullWidth"
           Disabled="@(_busy || Disabled)"
           OnClick="RunAsync">
    @if (_busy)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" Color="Color.Inherit" />
    }
    @ChildContent
</MudButton>

@code {
    [Parameter, EditorRequired] public Func<Task> OnClick { get; set; } = null!;
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _busy;

    private async Task RunAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await OnClick();
        }
        finally
        {
            _busy = false;
        }
    }
}
